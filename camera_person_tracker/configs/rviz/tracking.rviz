Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0.1

    - Class: rviz_default_plugins/Marker
      Name: Target Marker
      Enabled: true
      Namespaces:
        target_person: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort      # lighter than Reliable
        Value: /camera_person_tracker/target_marker

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_color_optical_frame   # changed
    Frame Rate: 15                            # reduced from 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.5
      Pitch: 0.3
      Yaw: 3.14
      Name: Current View
